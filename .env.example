NODE_ENV=development
PORT=3000
READ_ONLY=true
DATABASE_URL=
DB_SSL=true
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TRANSCRIBE_MODEL=
META_GRAPH_VERSION=v26.0
META_ADS_ACCESS_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
AUTHORIZED_PHONE_NUMBERS=
APPROVAL_TTL_MINUTES=10

# Client OAuth: user access token configuration with ads_read (not system-user tokens)
APP_PUBLIC_URL=
META_APP_ID=3244596585929846
META_LOGIN_CONFIG_ID=1547508470739287
# Separate reviewed user-token Facebook Login for Business configuration with ads_management.
# Keep empty until created in Meta; never reuse the read-only configuration as management.
META_MANAGEMENT_LOGIN_CONFIG_ID=
# Base64-encoded 32-byte AES key, kept outside the database
META_TOKEN_ENCRYPTION_KEY=
META_LEGACY_SINGLE_TENANT=false

# Independent production safety switches: keep off until separately authorized.
META_WRITES_ENABLED=false
WHATSAPP_SEND_ENABLED=false
WHATSAPP_WORKER_IN_WEB=true
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
APPROVAL_HMAC_KEY=
DELETION_HMAC_KEY=
META_TOKEN_KEY_ID=primary
META_TOKEN_PREVIOUS_KEYS={}
DB_CA_CERT=
ALLOW_PRIVATE_DB_PLAINTEXT=false
TRUST_PROXY_HOPS=0
DATA_RETENTION_DAYS=90
WHATSAPP_APPROVED_TEMPLATES=
PRIVACY_OPERATOR_NAME=קמפיין בצ׳ט
PRIVACY_CONTACT_EMAIL=yairdigitalil@gmail.com
PRIVACY_HOSTING_PROVIDER=Render
PRIVACY_BACKUP_RETENTION=
REQUIRE_WORKER_HEARTBEAT=false

# Generated campaign graphics (tenant-scoped, limited to three requests/hour)
GRAPHICS_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GRAPHICS_ATTEMPT_LIMIT=100
# Original Hebrew discovery bank. Set false to restore the pre-integration chat route.
MARKETING_DISCOVERY_ENABLED=true

# Connected customer journey. Keep public access off until owner review.
BUSINESS_LINK_ONBOARDING_ENABLED=false
PUBLIC_ONBOARDING_ENABLED=false
# Billing. Nothing is charged until BILLING_ENABLED=true AND the chosen provider is
# fully configured. Plans and prices live in billingPlans.js (flat monthly fee only).
# Stripe is one optional adapter (billingProviders.js); Grow/PayPlus/Cardcom can be added there.
BILLING_ENABLED=false
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One monthly ILS price per plan; each must equal the price in billingPlans.js.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PREMIUM=

# Bot task-manager pilot. CRM sync remains separate.
TASK_AGENT_ENABLED=false
TASK_AGENT_PILOT_ONLY=true
TASK_AGENT_EVALUATE_ON_START=false
TASK_AGENT_REQUIRE_EVAL=true

# One conversation owner; legacy marketing/brief flows cannot take over pilot requests.
UNIFIED_CONVERSATION_ENABLED=false
SCOPED_AUTOMATION_ENABLED=false
UNIFIED_PORTAL_AGENT_ENABLED=false

# Enable after configuring the Meta Page leadgen subscription and permissions.
META_LEAD_IMPORT_ENABLED=false

# Short ad videos via Higgsfield (https://console.higgsfield.ai). Format: <key id>:<key secret>
HF_CREDENTIALS=
VIDEO_ENABLED=false
VIDEO_MONTHLY_LIMIT=8
# Optional per-model USD price overrides for the AI cost ledger (JSON)
USAGE_PRICES_JSON=
# Optional: provider that answers when AI_PROVIDER fails (claude|gemini)
AI_FALLBACK_PROVIDER=
# New-lead WhatsApp alerts to the business owner (on unless "false"). Outside the 24h window an
# approved template is used when set (name must also be listed in WHATSAPP_APPROVED_TEMPLATES).
LEAD_ALERTS_ENABLED=true
LEAD_ALERT_TEMPLATE=
LEAD_ALERT_TEMPLATE_LANGUAGE=he
# Proactive follow-ups: lead check-ins (on unless "false") and the Sunday weekly report
LEAD_CHECKINS_ENABLED=true
WEEKLY_REPORTS_ENABLED=false
WEEKLY_REPORT_TEMPLATE=
WEEKLY_REPORT_TEMPLATE_LANGUAGE=he
