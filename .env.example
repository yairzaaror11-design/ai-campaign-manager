NODE_ENV=development
PORT=3000
READ_ONLY=true
DATABASE_URL=
DB_SSL=true
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TRANSCRIBE_MODEL=
META_GRAPH_VERSION=v26.0
META_ADS_ACCESS_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
AUTHORIZED_PHONE_NUMBERS=
APPROVAL_TTL_MINUTES=10

# Client OAuth: user access token configuration with ads_read (not system-user tokens)
APP_PUBLIC_URL=
META_APP_ID=3244596585929846
META_LOGIN_CONFIG_ID=1547508470739287
# Base64-encoded 32-byte AES key, kept outside the database
META_TOKEN_ENCRYPTION_KEY=
META_LEGACY_SINGLE_TENANT=false

# Independent production safety switches: keep off until separately authorized.
META_WRITES_ENABLED=false
WHATSAPP_SEND_ENABLED=false
WHATSAPP_WORKER_IN_WEB=true
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
APPROVAL_HMAC_KEY=
DELETION_HMAC_KEY=
META_TOKEN_KEY_ID=primary
META_TOKEN_PREVIOUS_KEYS={}
DB_CA_CERT=
ALLOW_PRIVATE_DB_PLAINTEXT=false
TRUST_PROXY_HOPS=0
DATA_RETENTION_DAYS=90
WHATSAPP_APPROVED_TEMPLATES=
PRIVACY_OPERATOR_NAME=קמפיין בצ׳ט
PRIVACY_CONTACT_EMAIL=yairdigitalil@gmail.com
PRIVACY_HOSTING_PROVIDER=Render
PRIVACY_BACKUP_RETENTION=
REQUIRE_WORKER_HEARTBEAT=false

# Generated campaign graphics (tenant-scoped, limited to three requests/hour)
GRAPHICS_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GRAPHICS_ATTEMPT_LIMIT=100
# Original Hebrew discovery bank. Set false to restore the pre-integration chat route.
MARKETING_DISCOVERY_ENABLED=true

# Browser dashboard: initial administrator-provisioned access to an EXISTING client.
# Exact origin; HTTPS in production. Never commit actual token hashes or private tokens.
# DASHBOARD_ORIGIN=http://localhost:3000
# DASHBOARD_ACCOUNTS=[{"clientId":"EXISTING_CLIENT_ID","role":"owner","tokenHash":"SHA256_OF_A_STRONG_RANDOM_PRIVATE_TOKEN"}]
