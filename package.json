{
  "name": "campaign-bachat",
  "version": "1.8.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "check": "node -e \"const fs=require('fs'),cp=require('child_process');function scan(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){if(['node_modules','.git','src'].includes(e.name))continue;const p=d+'/'+e.name;if(e.isDirectory())scan(p);else if(e.name.endsWith('.js'))cp.execFileSync(process.execPath,['--check',p],{stdio:'inherit'})}}scan('.')\"",
    "test": "node --test tests/*.test.js",
    "preflight": "node scripts/preflight.js",
    "worker:messages": "node messageWorker.js"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "sharp": "^0.35.5",
    "winston": "^3.17.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11"
  }
}
