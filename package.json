  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "check": "node -e \"const fs=require('fs'),cp=require('child_process');for(const f of fs.readdirSync('.').filter(x=>x.endsWith('.js')).concat(fs.readdirSync('tests').filter(x=>x.endsWith('.js')).map(x=>'tests/'+x))){cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'})}\"",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "winston": "^3.17.0",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=20"
  }
}
